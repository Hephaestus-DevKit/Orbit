{
  "name": "@orbit-build/acp",
  "version": "1.8.1",
  "license": "Apache-2.0",
  "description": "Orbit bridge for stable Agent Client Protocol v1 external agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
